<!--==================================================
HEADER

ホーム画面最上部。

ゲームタイトルとANIMUS HUDを表示します。

スマホではメニューを置かず、
HUDをタップしてANIMUS TERMINALを開きます。

===================================================-->

<header id="topBar">

    <!--==============================
    Game Logo
    ==============================-->

    <div id="gameTitle">

        星守戦線

    </div>

</header>



<!--==================================================
ANIMUS HUD

スマホ版では
このHUD全体をタップすると
ANIMUS TERMINALを開きます。

表示内容

・所持金
・AP
・BP
・CP

今後追加予定

・通知
・メール
・イベント

===================================================-->

<section id="statusBar">

    <div class="statusItem">

        💰
        <strong id="moneyValue">

            2,450,000 Cr

        </strong>

    </div>

    <div class="statusItem">

        ⚡
        <strong id="apValue">

            AP 120 / 120

        </strong>

    </div>

    <div class="statusItem">

        🔥
        <strong id="bpValue">

            BP 5 / 5

        </strong>

    </div>

    <div class="statusItem">

        ◇
        <strong id="cpValue">

            CP 8 / 10

        </strong>

    </div>

</section>



<!--==================================================
ANIMUS TERMINAL

通常は閉じています。

HUDをタップすると
右からスライド表示。

ホーム画面のメニューと
各種情報をまとめます。

===================================================-->

<aside id="mobileTerminal">

    <!--==============================
    Terminal Header
    ==============================-->

    <div id="terminalHeader">

        <h2>

            ANIMUS TERMINAL

        </h2>

        <span id="terminalClose">

            ✕

        </span>

    </div>



    <!--==============================
    Navigation
    ==============================-->

    <nav id="terminalNav">

        <button>

            🏠
            ホーム

        </button>

        <button>

            🧭
            探索

        </button>

        <button>

            ⚔
            戦闘

        </button>

        <button>

            🛡
            防衛

        </button>

        <button>

            🔨
            工房

        </button>

        <button>

            📖
            図鑑

        </button>

        <button>

            💬
            チャット

        </button>

        <button>

            ⚙
            設定

        </button>

    </nav>



    <!--==============================
    Terminal Status
    ==============================-->

    <section id="terminalStatus">

        <div class="terminalItem">

            接続状態

            <span class="online">

                ONLINE

            </span>

        </div>

        <div class="terminalItem">

            世界安定度

            <span>

                98.4%

            </span>

        </div>

        <div class="terminalItem">

            侵食率

            <span class="warning">

                12%

            </span>

        </div>

        <div class="terminalItem">

            現在地

            <span>

                煌萊都市・耀月

            </span>

        </div>

    </section>

</aside>

<!--==================================================
Hero Area

ホーム画面の主役。

プレイヤーがホームを開いた瞬間に
最初に目へ入るエリアです。

表示順

Welcome
↓

System of ANIMUS
↓

立ち絵
↓

キャラクターカルーセル

===================================================-->

<section id="heroArea">

    <!--==========================================
    Welcome
    ===========================================-->

    <div id="welcomeArea">

        <h1 id="welcomeText">

            Welcome.

        </h1>

        <p id="animusLogo">

            System of ANIMUS

        </p>

    </div>



    <!--==========================================
    Character Area

    表示キャラクター

    JavaScriptで画像切り替え予定

    ===========================================-->

    <div id="characterArea">

        <img

            id="characterImage"

            src="images/character/shizumi.webp"

            alt="静海"

        >

    </div>



    <!--==========================================
    Character Carousel

    救世者一覧

    後でJavaScriptから
    自動生成予定。

    ===========================================-->

    <section id="carouselArea">

        <div id="characterList">

            <button class="characterCard active">

                <img
                    src="images/icon/shizumi.webp"
                    alt="静海">

                <span>

                    静海

                </span>

            </button>



            <button class="characterCard">

                <img
                    src="images/icon/keika.webp"
                    alt="恵佳">

                <span>

                    恵佳

                </span>

            </button>



            <button class="characterCard">

                <img
                    src="images/icon/kohaku.webp"
                    alt="瑚白">

                <span>

                    瑚白

                </span>

            </button>



            <button class="characterCard">

                <img
                    src="images/icon/houraku.webp"
                    alt="宝楽">

                <span>

                    宝楽

                </span>

            </button>

        </div>

    </section>

</section>

<!--==================================================
Main Container

ホーム画面本体。

スマホ版では

Hero Area

のみ表示。

右パネルの情報は

ANIMUS TERMINALへ集約します。

===================================================-->

<main id="mainContainer">

    <!--==========================================
    Hero Area

    ホーム画面の主人公。

    Welcome

        ↓

    Character

        ↓

    Carousel

    ===========================================-->

    <section id="heroArea">

        <!--==============================
        Welcome
        ==============================-->

        <div id="welcomeArea">

            <h1 id="welcomeText">

                Welcome.

            </h1>

            <p id="animusLogo">

                System of ANIMUS

            </p>

        </div>



        <!--==============================
        Character
        ==============================-->

        <div id="characterArea">

            <img

                id="characterImage"

                src="images/character/shizumi.webp"

                alt="静海"

            >

        </div>



        <!--==============================
        Character Carousel
        ==============================-->

        <section id="carouselArea">

            <div id="characterList">

                <!-- 静海 -->

                <button class="characterCard active">

                    <img
                        src="images/icon/shizumi.webp">

                    <span>

                        静海

                    </span>

                </button>



                <!-- 恵佳 -->

                <button class="characterCard">

                    <img
                        src="images/icon/keika.webp">

                    <span>

                        恵佳

                    </span>

                </button>



                <!-- 瑚白 -->

                <button class="characterCard">

                    <img
                        src="images/icon/kohaku.webp">

                    <span>

                        瑚白

                    </span>

                </button>



                <!-- 宝楽 -->

                <button class="characterCard">

                    <img
                        src="images/icon/houraku.webp">

                    <span>

                        宝楽

                    </span>

                </button>

            </div>

        </section>

    </section>

</main>

<!--==================================================
ANIMUS Overlay

司令官専用端末。

HUDをタップすると表示。

救世者はNPCなので
ここは「指示・情報確認」を行う画面。

===================================================-->

<div id="terminalOverlay">

    <!-- 背景を暗くする -->
    <div id="terminalBackdrop"></div>

    <!--==============================
    Terminal Window
    ==============================-->

    <aside id="mobileTerminal">

        <!--======================================
        Header
        =======================================-->

        <header id="terminalHeader">

            <div>

                <h2>

                    ANIMUS TERMINAL

                </h2>

                <small>

                    Commander Interface

                </small>

            </div>

            <button id="terminalClose">

                ✕

            </button>

        </header>
        
                <!--======================================
        Current Savior
        =======================================-->

        <section id="currentSavior">

            <img

                id="terminalPortrait"

                src="images/icon/shizumi.webp"

                alt="静海"

            >

            <div>

                <h3>

                    十束 静海

                </h3>

                <p>

                    通信中

                </p>

            </div>

        </section>
        
                <!--======================================
        Navigation
        =======================================-->

        <nav id="terminalNav">

            <button>🏠 ホーム</button>

            <button>📡 通信</button>

            <button>🛡 防衛状況</button>

            <button>⚔ 任務</button>

            <button>📖 データベース</button>

            <button>🌍 世界状況</button>

            <button>🔨 工房</button>

            <button>⚙ 設定</button>

        </nav>
        
                <!--======================================
        System Status
        =======================================-->

        <section id="terminalStatus">

            <div class="terminalItem">

                接続状態

                <span class="online">

                    ONLINE

                </span>

            </div>

            <div class="terminalItem">

                世界安定度

                <span>

                    98.4%

                </span>

            </div>

            <div class="terminalItem">

                侵食率

                <span class="warning">

                    12%

                </span>

            </div>

            <div class="terminalItem">

                現在地

                <span>

                    煌萊都市・耀月

                </span>

            </div>

        </section>

    </aside>

</div>
